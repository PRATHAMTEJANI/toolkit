NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
REDIS_URL=redis://127.0.0.1:6379
# Local executable paths are optional when using the cloud Docker image.
LIBREOFFICE_PATH=
FFMPEG_PATH=
PDFTOPPM_PATH=
ADMIN_DASHBOARD_TOKEN=replace-with-a-long-random-secret
MAX_UPLOAD_BYTES=104857600
RESULT_URL_TTL_SECONDS=600
TEMP_FILE_TTL_SECONDS=3600
# Optional trusted hosting geo headers (Vercel sets x-vercel-ip-country/latitude/longitude).
# No raw IP address is persisted. City enrichment requires a trusted provider integration.
TRUST_PROXY_GEO_HEADERS=false
# Optional ClamAV daemon (production processing should configure this).
# CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
